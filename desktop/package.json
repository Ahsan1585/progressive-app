{
  "name": "izaya-eis-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Izaya EIS — Admin Dashboard desktop app (Electron shell around the frontend/ admin-dashboard build)",
  "main": "src/main.js",
  "scripts": {
    "dev": "cross-env ELECTRON_DEV=1 electron .",
    "generate-icon": "node scripts/generate-icon.mjs",
    "build:renderer": "cd ../frontend && npm run build:desktop",
    "package:win": "npm run build:renderer && electron-builder --win",
    "release:win": "npm run build:renderer && electron-builder --win --publish always"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.izayaedge.eis.admin",
    "productName": "Izaya EIS",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "../frontend/dist-desktop/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist-desktop",
        "to": "renderer"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "Ahsan1585",
      "repo": "progressive-app"
    }
  }
}
